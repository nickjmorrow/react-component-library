{
    "name": "@nickjmorrow/react-component-library",
    "version": "0.1.0",
    "description": "Personal component library",
    "author": "nickjmorrow",
    "license": "MIT",
    "repository": "nickjmorrow/react-component-library",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "*.css"
    ],
    "engines": {
        "node": ">=22.12"
    },
    "workspaces": [
        "example"
    ],
    "scripts": {
        "dev": "npm run dev -w example",
        "build": "vite build",
        "build:example": "npm run build -w example",
        "preview": "npm run preview -w example",
        "deploy": "npm run build:example && gh-pages -d example/dist",
        "typecheck": "tsc --noEmit && npm run typecheck -w example",
        "test": "vitest run",
        "lint": "eslint .",
        "format": "prettier --write \"{src,example/src}/**/*.{ts,tsx,css}\""
    },
    "dependencies": {
        "@emotion/is-prop-valid": "^1.4.0",
        "@react-oauth/google": "^0.13.5",
        "deepmerge": "^4.3.1",
        "radix-ui": "^1.6.7",
        "rc-slider": "^11.1.9",
        "react-collapse": "^5.1.1",
        "react-spinners": "^0.17.1",
        "react-transition-group": "^4.4.5",
        "ts-essentials": "^10.2.1"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router": "^7.0.0 || ^8.0.0",
        "styled-components": "^6.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "^19.3.0",
        "@types/react-collapse": "^5.0.4",
        "@types/react-dom": "^19.2.0",
        "@types/react-transition-group": "^4.4.12",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^9.39.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-react": "^7.37.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "gh-pages": "^6.0.0",
        "globals": "^17.0.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router": "^8.4.0",
        "styled-components": "^6.5.3",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.0",
        "vite-plugin-dts": "^5.1.1",
        "vitest": "^5.0.1"
    }
}
